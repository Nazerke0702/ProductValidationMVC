@{ ViewData["Title"] = "Тауар тіркелді"; }

<section class="success-card">
    <div class="success-orbit"><div class="success-check">✓</div><span class="success-sparkle">✦</span></div>
    <span class="eyebrow">СӘТТІ ОРЫНДАЛДЫ</span>
    <h1>Тауар сәтті тіркелді!</h1>
    <p>Жаңа өнім каталогқа қосылып, SQLite деректер қорына сақталды. Енді оны тізімнен қарай аласыз.</p>
    <div class="success-actions"><a asp-action="Index" class="btn btn-studio-primary">Тауарлар тізіміне қайту <span aria-hidden="true">→</span></a><a asp-action="Create" class="btn btn-studio-secondary">Тағы тауар қосу</a></div>
</section>
